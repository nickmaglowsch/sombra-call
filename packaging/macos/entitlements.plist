<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Sombra.app's hardened-runtime entitlements. Each one is justified in ADR 0050;
     do not add one without evidence that the app fails without it. -->
<plist version="1.0">
<dict>
	<!-- The microphone (EU track). Under the hardened runtime, audio input is refused
	     without it, even when the user has granted Microphone in TCC. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
