<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Sombra.app's hardened-runtime entitlements. Each one is justified in ADR 0050;
     do not add one without evidence that the app fails without it. -->
<plist version="1.0">
<dict>
	<!-- The microphone (EU track). Under the hardened runtime, audio input is refused
	     without it, even when the user has granted Microphone in TCC. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Our own dylibs (libpython, onnxruntime, whisper.cpp, PortAudio, extension modules).
	     A self-signed or ad-hoc signature has no Team ID, and macOS 27 library validation
	     refuses every non-platform dylib of such an app ("different Team IDs"), so the app
	     cannot start without it. macOS 14 accepts the empty team. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
